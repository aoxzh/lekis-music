root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,toml,wit,xml,xaml,kts}]
indent_size = 2

[*.{ts,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{ps1,cs,csproj,sln,xaml}]
end_of_line = crlf
