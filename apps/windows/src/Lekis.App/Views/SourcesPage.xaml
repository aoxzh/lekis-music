<Page
    x:Class="Lekis.App.Views.SourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Lekis.App.Common"
    xmlns:core="using:Lekis.Core"
    Padding="{StaticResource LekisPageMargin}">

    <Page.Resources>
        <!-- 音源类型显示成 SourceKind_<成员名> -->
        <common:EnumTextConverter x:Key="KindText" Prefix="SourceKind" />
    </Page.Resources>

    <!--
      音源管理。原型只支持"添加本地文件夹 + 扫描"。
      选文件夹用 FolderPicker（免打包应用要先 InitializeWithWindow），扫描本身完全交给核心。
    -->
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="Sources_Title" Style="{StaticResource LekisDisplayTextStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
            <Button x:Uid="Sources_AddLocal" Click="OnAddLocalFolderClick" Style="{StaticResource AccentButtonStyle}" />
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource LekisCaptionTextStyle}"
                Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                Visibility="{x:Bind common:Format.VisibleIfText(ViewModel.Status), Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <TextBlock x:Uid="Sources_Empty" Grid.Row="2" Style="{StaticResource LekisCaptionTextStyle}" Margin="0,8,0,0" />

        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Sources}" SelectionMode="None" Margin="0,8,0,0">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:Source">
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{ThemeResource LekisOnSurfaceVariantBrush}" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource LekisBodyTextStyle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource LekisCaptionTextStyle}" Text="{x:Bind Kind, Converter={StaticResource KindText}}" />
                            <TextBlock Style="{StaticResource LekisCaptionTextStyle}" Text="{x:Bind RootPath}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button Grid.Column="2" x:Uid="Sources_Rescan" Click="OnRescanClick" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
