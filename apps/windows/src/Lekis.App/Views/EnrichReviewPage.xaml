<Page
    x:Class="Lekis.App.Views.EnrichReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Lekis.App.Common"
    Padding="{StaticResource LekisPageMargin}">

    <!--
      补全结果待确认队列（REQUIREMENTS ENR-06：置信度 0.5–0.85 的候选要用户确认）。
      目前核心只推送队列长度，候选列表 / 接受 / 拒绝还没有接口，所以这里只显示待确认数量。
      TODO(ENR-*)：核心暴露 list_enrich_candidates / accept / reject 后，在这里列出"当前值 vs 候选值 + 来源 + 置信度"。
    -->
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="Enrich_Title" Style="{StaticResource LekisDisplayTextStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0" VerticalAlignment="Center">
            <TextBlock x:Uid="Enrich_PendingLabel" VerticalAlignment="Center" Style="{StaticResource LekisBodyTextStyle}" />
            <TextBlock Style="{StaticResource LekisHeadlineTextStyle}" Text="{x:Bind ViewModel.Pending, Mode=OneWay}" />
        </StackPanel>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Spacing="8">
            <TextBlock
                x:Uid="Enrich_EmptyTitle"
                HorizontalAlignment="Center"
                Style="{StaticResource LekisHeadlineTextStyle}"
                TextAlignment="Center"
                Visibility="{x:Bind common:Format.VisibleIfZero(ViewModel.Pending), Mode=OneWay}" />
            <TextBlock
                x:Uid="Enrich_NotAvailable"
                HorizontalAlignment="Center"
                Style="{StaticResource LekisCaptionTextStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="{x:Bind common:Format.VisibleIfPositive(ViewModel.Pending), Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
