<Page
    x:Class="Lekis.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Lekis.App.Common"
    xmlns:controls="using:Lekis.App.Controls"
    xmlns:core="using:Lekis.Core"
    Padding="{StaticResource LekisPageMargin}">

    <!--
      搜索。输入防抖 250ms 后由 SearchViewModel 调核心查询；
      拼音 / 简繁 / 首字母匹配都在核心里做，这里不做任何文本处理。
    -->
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="Search_Title" Style="{StaticResource LekisDisplayTextStyle}" />

        <AutoSuggestBox
            x:Uid="Search_Box"
            Grid.Row="1"
            Margin="0,8,0,0"
            QueryIcon="Find"
            Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <ListView
            Grid.Row="2"
            IsItemClickEnabled="True"
            ItemClick="OnTrackClick"
            ItemsSource="{x:Bind ViewModel.Results}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:TrackRow">
                    <controls:TrackListItem Track="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Uid="Search_Empty"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource LekisCaptionTextStyle}"
            Visibility="{x:Bind common:Format.VisibleIfTrue(ViewModel.IsEmpty), Mode=OneWay}" />
    </Grid>
</Page>
