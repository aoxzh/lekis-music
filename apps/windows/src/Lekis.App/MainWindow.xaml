<Window
    x:Class="Lekis.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lekis.App.Controls"
    Title="Lekis">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏（ExtendsContentIntoTitleBar） -->
        <Grid x:Name="AppTitleBar" Padding="16,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE708;" FontSize="14" Foreground="{ThemeResource LekisMoonBrush}" VerticalAlignment="Center" />
            <TextBlock x:Uid="AppTitle" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            OpenPaneLength="{StaticResource LekisSidebarWidth}"
            SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Nav_Home" Icon="Home" Tag="home" />
                <NavigationViewItem x:Uid="Nav_Library" Icon="Library" Tag="library" />
                <NavigationViewItem x:Uid="Nav_Search" Icon="Find" Tag="search" />
                <NavigationViewItem x:Uid="Nav_NowPlaying" Icon="Audio" Tag="nowplaying" />
                <NavigationViewItemSeparator />
                <NavigationViewItem x:Uid="Nav_Sources" Icon="MapDrive" Tag="sources" />
                <NavigationViewItem x:Uid="Nav_Enrich" Icon="Tag" Tag="enrich" />
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <controls:PlayerBar Grid.Row="2" />
    </Grid>
</Window>
