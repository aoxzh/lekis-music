<UserControl
    x:Class="Lekis.App.Controls.TrackListItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Lekis.App.Common">

    <!-- 所有歌曲列表共用的一行（与 Android 的 TrackListItem 对应）。 -->
    <Grid Padding="0,6" ColumnSpacing="{StaticResource LekisSpacingMd}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- TODO(ENR-*)：核心提供缩略图本地路径后，换成 Image（解码尺寸 = 显示尺寸 × DPI 缩放）。 -->
        <Border
            Width="{StaticResource LekisListArtworkSize}"
            Height="{StaticResource LekisListArtworkSize}"
            Background="{ThemeResource LekisSurfaceVariantBrush}"
            CornerRadius="{StaticResource LekisArtworkListRadius}">
            <FontIcon Glyph="&#xE8D6;" FontSize="18" Foreground="{ThemeResource LekisOnSurfaceVariantBrush}" />
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Style="{StaticResource LekisBodyTextStyle}" Text="{x:Bind Track.Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource LekisCaptionTextStyle}" Text="{x:Bind common:Format.Subtitle(Track), Mode=OneWay}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Border Grid.Column="2" Style="{StaticResource LekisQualityBadgeStyle}" Visibility="{x:Bind common:Format.VisibleIfText(Track.QualityBadge), Mode=OneWay, FallbackValue=Collapsed}">
            <TextBlock FontSize="11" Foreground="{ThemeResource LekisAccentBrush}" Text="{x:Bind Track.QualityBadge, Mode=OneWay}" />
        </Border>

        <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource LekisCaptionTextStyle}" Text="{x:Bind common:Format.Duration(Track.DurationMs), Mode=OneWay, FallbackValue=''}" />
    </Grid>
</UserControl>
