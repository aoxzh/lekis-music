<UserControl
    x:Class="Lekis.App.Controls.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Lekis.App.Common"
    Height="{StaticResource LekisPlayerBarHeight}">

    <!--
      底部播放条（对应 Android 的迷你播放器）：封面占位 + 曲目信息 + 传输按钮 + 进度。
      数据全部来自 PlayerViewModel；这里只负责显示，用户手势转成 ViewModel 的调用。
    -->
    <Border Background="{ThemeResource LekisSurfaceBrush}" BorderBrush="{ThemeResource LekisOutlineBrush}" BorderThickness="0,1,0,0">
        <Grid Padding="16,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- TODO(ENR-*)：核心提供缩略图本地路径后换成 Image（解码尺寸 = 显示尺寸 × DPI 缩放）。 -->
            <Border
                Width="{StaticResource LekisListArtworkSize}"
                Height="{StaticResource LekisListArtworkSize}"
                Background="{ThemeResource LekisSurfaceVariantBrush}"
                CornerRadius="{StaticResource LekisArtworkListRadius}">
                <FontIcon Glyph="&#xE8D6;" FontSize="18" Foreground="{ThemeResource LekisOnSurfaceVariantBrush}" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="8,0,0,0">
                <TextBlock
                    Style="{StaticResource LekisBodyTextStyle}"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Uid="PlayerBar_NoTrack"
                    Style="{StaticResource LekisCaptionTextStyle}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind common:Format.VisibleIfFalse(ViewModel.HasTrack), Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource LekisCaptionTextStyle}"
                    Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind common:Format.VisibleIfText(ViewModel.Subtitle), Mode=OneWay}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button
                    x:Uid="PlayerBar_Previous"
                    Command="{x:Bind ViewModel.PreviousCommand}"
                    Width="36"
                    Height="36"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0">
                    <FontIcon Glyph="&#xE892;" FontSize="16" Foreground="{ThemeResource LekisOnSurfaceBrush}" />
                </Button>
                <Button
                    x:Uid="PlayerBar_PlayPause"
                    Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                    Width="40"
                    Height="40"
                    Padding="0"
                    Background="{ThemeResource LekisAccentBrush}"
                    BorderThickness="0"
                    CornerRadius="{StaticResource LekisRadiusPill}">
                    <FontIcon
                        Glyph="{x:Bind common:Format.PlayPauseGlyph(ViewModel.IsPlaying), Mode=OneWay}"
                        FontSize="16"
                        Foreground="{ThemeResource LekisOnAccentBrush}" />
                </Button>
                <Button
                    x:Uid="PlayerBar_Next"
                    Command="{x:Bind ViewModel.NextCommand}"
                    Width="36"
                    Height="36"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0">
                    <FontIcon Glyph="&#xE893;" FontSize="16" Foreground="{ThemeResource LekisOnSurfaceBrush}" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="3" Width="320" VerticalAlignment="Center">
                <Slider
                    x:Name="PositionSlider"
                    Minimum="0"
                    Maximum="{x:Bind ViewModel.DurationMs, Mode=OneWay}"
                    StepFrequency="1000"
                    ValueChanged="OnPositionChanged"
                    Margin="0,0,0,-6" />
                <Grid>
                    <TextBlock
                        Style="{StaticResource LekisCaptionTextStyle}"
                        HorizontalAlignment="Left"
                        Text="{x:Bind common:Format.DurationD(ViewModel.PositionMs), Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource LekisCaptionTextStyle}"
                        HorizontalAlignment="Right"
                        Text="{x:Bind common:Format.DurationD(ViewModel.DurationMs), Mode=OneWay}" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
