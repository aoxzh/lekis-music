<!--
  Lekis 设计 Token（Windows）。唯一来源：design/tokens.json —— 改颜色/尺寸先改那个文件，再同步到这里和
  Android 的 core/designsystem/Tokens.kt。以后由脚本自动生成，到时候这个文件会变成生成产物。

  命名规则：Lekis<语义名><类型>，例如 LekisAccentBrush、LekisListArtworkSize。
  页面里只能用这些语义资源或系统主题资源，不要写死颜色值。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="LekisBackgroundBrush" Color="#FBFAFF" />
            <SolidColorBrush x:Key="LekisSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="LekisSurfaceVariantBrush" Color="#F1EFF8" />
            <SolidColorBrush x:Key="LekisSurfaceElevatedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="LekisOnSurfaceBrush" Color="#14131A" />
            <SolidColorBrush x:Key="LekisOnSurfaceVariantBrush" Color="#5E5B6B" />
            <SolidColorBrush x:Key="LekisOutlineBrush" Color="#DDDAE6" />
            <SolidColorBrush x:Key="LekisAccentBrush" Color="#5B57D6" />
            <SolidColorBrush x:Key="LekisOnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="LekisAccentSoftBrush" Color="#E7E5FF" />
            <SolidColorBrush x:Key="LekisMoonBrush" Color="#E8B04B" />
            <SolidColorBrush x:Key="LekisDangerBrush" Color="#D6455B" />
            <SolidColorBrush x:Key="LekisScrimBrush" Color="#66000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="LekisBackgroundBrush" Color="#0B0A10" />
            <SolidColorBrush x:Key="LekisSurfaceBrush" Color="#15141C" />
            <SolidColorBrush x:Key="LekisSurfaceVariantBrush" Color="#201E29" />
            <SolidColorBrush x:Key="LekisSurfaceElevatedBrush" Color="#1C1B24" />
            <SolidColorBrush x:Key="LekisOnSurfaceBrush" Color="#F3F1FA" />
            <SolidColorBrush x:Key="LekisOnSurfaceVariantBrush" Color="#A9A5B8" />
            <SolidColorBrush x:Key="LekisOutlineBrush" Color="#2E2C3A" />
            <SolidColorBrush x:Key="LekisAccentBrush" Color="#9C99FF" />
            <SolidColorBrush x:Key="LekisOnAccentBrush" Color="#0B0A10" />
            <SolidColorBrush x:Key="LekisAccentSoftBrush" Color="#2A2850" />
            <SolidColorBrush x:Key="LekisMoonBrush" Color="#F2C46B" />
            <SolidColorBrush x:Key="LekisDangerBrush" Color="#FF6B81" />
            <SolidColorBrush x:Key="LekisScrimBrush" Color="#99000000" />
        </ResourceDictionary>
        <!-- 高对比度：一律映射到系统颜色，不使用品牌色（无障碍要求）。 -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="LekisBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LekisSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LekisSurfaceVariantBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LekisSurfaceElevatedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LekisOnSurfaceBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LekisOnSurfaceVariantBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LekisOutlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LekisAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LekisOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="LekisAccentSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LekisMoonBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LekisDangerBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LekisScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 圆角 -->
    <CornerRadius x:Key="LekisRadiusSm">8</CornerRadius>
    <CornerRadius x:Key="LekisRadiusMd">12</CornerRadius>
    <CornerRadius x:Key="LekisRadiusLg">16</CornerRadius>
    <CornerRadius x:Key="LekisRadiusPill">999</CornerRadius>
    <CornerRadius x:Key="LekisArtworkListRadius">6</CornerRadius>
    <CornerRadius x:Key="LekisArtworkGridRadius">10</CornerRadius>
    <CornerRadius x:Key="LekisArtworkNowPlayingRadius">14</CornerRadius>

    <!-- 间距 -->
    <x:Double x:Key="LekisSpacingXs">4</x:Double>
    <x:Double x:Key="LekisSpacingSm">8</x:Double>
    <x:Double x:Key="LekisSpacingMd">12</x:Double>
    <x:Double x:Key="LekisSpacingLg">16</x:Double>
    <x:Double x:Key="LekisSpacingXl">24</x:Double>
    <x:Double x:Key="LekisSpacingXxl">32</x:Double>
    <Thickness x:Key="LekisPageMargin">32,24,32,0</Thickness>

    <!-- 尺寸 -->
    <x:Double x:Key="LekisListArtworkSize">48</x:Double>
    <x:Double x:Key="LekisGridArtworkMin">160</x:Double>
    <x:Double x:Key="LekisPlayerBarHeight">88</x:Double>
    <x:Double x:Key="LekisSidebarWidth">240</x:Double>
    <x:Double x:Key="LekisNowPlayingArtworkSize">320</x:Double>

    <!-- 字体：中文走系统字体回退（Segoe UI Variable → 微软雅黑 UI） -->
    <Style x:Key="LekisDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource LekisOnSurfaceBrush}" />
    </Style>
    <Style x:Key="LekisTitle1TextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="34" />
        <Setter Property="Foreground" Value="{ThemeResource LekisOnSurfaceBrush}" />
    </Style>
    <Style x:Key="LekisTitle2TextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="Foreground" Value="{ThemeResource LekisOnSurfaceBrush}" />
    </Style>
    <Style x:Key="LekisHeadlineTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="Foreground" Value="{ThemeResource LekisOnSurfaceBrush}" />
    </Style>
    <Style x:Key="LekisBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource LekisOnSurfaceBrush}" />
    </Style>
    <Style x:Key="LekisCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource LekisOnSurfaceVariantBrush}" />
    </Style>

    <!-- 音质标签（Hi-Res / FLAC 16/44 ……） -->
    <Style x:Key="LekisQualityBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LekisAccentSoftBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
