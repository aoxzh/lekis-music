<?xml version="1.0" encoding="utf-8"?>
<!-- 4×1：封面 · 歌名 / 艺人 · 上一首 / 播放 / 下一首 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="6dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/widget_cover"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_cover_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_not_playing"
            android:textColor="@color/widget_title"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_tap_to_open"
            android:textColor="@color/widget_subtitle"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_prev"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/widget_previous"
        android:padding="6dp"
        android:src="@drawable/ic_media_prev"
        android:tint="@color/widget_control" />

    <ImageView
        android:id="@+id/widget_play"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:background="@drawable/widget_play_button"
        android:contentDescription="@string/widget_play"
        android:padding="8dp"
        android:src="@drawable/ic_media_play"
        android:tint="@color/widget_on_accent" />

    <ImageView
        android:id="@+id/widget_next"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/widget_next"
        android:padding="6dp"
        android:src="@drawable/ic_media_next"
        android:tint="@color/widget_control" />
</LinearLayout>
