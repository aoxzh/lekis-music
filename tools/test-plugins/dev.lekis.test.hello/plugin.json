{
  "$schema": "../../../plugin-sdk/schema/plugin.schema.json",
  "id": "dev.lekis.test.hello",
  "name": "本地测试插件",
  "version": "1.0.0",
  "apiVersion": "1.0",
  "minAppVersion": "0.1.0",
  "runtime": "js",
  "entry": "index.js",
  "kinds": ["lyrics"],
  "author": "Lekis",
  "permissions": {
    "network": ["example.com"],
    "storageKb": 2048
  },
  "settings": [
    {
      "key": "greeting",
      "type": "string",
      "label": "问候语",
      "help": "插件返回歌词时使用的问候语。",
      "default": "你好，Lekis！"
    },
    {
      "key": "includeTime",
      "type": "boolean",
      "label": "显示当前时间",
      "help": "在歌词末尾附加一个时间戳。",
      "default": true
    },
    {
      "key": "mode",
      "type": "select",
      "label": "返回模式",
      "help": "简单模式只返回一行文本。",
      "options": ["simple", "detailed"],
      "default": "simple"
    },
    {
      "key": "apiKey",
      "type": "password",
      "label": "测试密钥",
      "help": "只用来检查密码字段不会回显。"
    }
  ]
}
