{
  "$description": "Lekis 设计 Token 的唯一来源。Android（core/designsystem/.../Tokens.kt）和 Windows（Themes/Tokens.xaml）必须与本文件一致；以后用脚本自动生成。颜色为 #RRGGBB 或 #AARRGGBB。",
  "version": 1,
  "color": {
    "light": {
      "background": "#F8F7FC",
      "surface": "#FFFFFF",
      "surfaceVariant": "#EFEDF7",
      "surfaceElevated": "#FFFFFF",
      "onBackground": "#17151F",
      "onSurface": "#17151F",
      "onSurfaceVariant": "#615D70",
      "outline": "#DEDAE9",
      "accent": "#4F46C8",
      "onAccent": "#FFFFFF",
      "accentSoft": "#E8E5FF",
      "moon": "#B9821F",
      "aurora": "#1F7A6B",
      "danger": "#C03A4E",
      "scrim": "#66000000"
    },
    "dark": {
      "background": "#08070F",
      "surface": "#0F0E17",
      "surfaceVariant": "#181624",
      "surfaceElevated": "#14121E",
      "onBackground": "#F4F1FA",
      "onSurface": "#F4F1FA",
      "onSurfaceVariant": "#A5A1B5",
      "outline": "#29263A",
      "accent": "#6E5BF0",
      "onAccent": "#FFFFFF",
      "accentSoft": "#221D3F",
      "moon": "#F2C46B",
      "aurora": "#79D6C2",
      "danger": "#FF6B81",
      "scrim": "#B3000000"
    },
    "oledBlack": {
      "$description": "纯黑 OLED 主题：只覆盖这些值，其余沿用 dark。",
      "background": "#000000",
      "surface": "#08070D",
      "surfaceVariant": "#12101A",
      "surfaceElevated": "#0C0A12"
    }
  },
  "radius": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 18,
    "xl": 28,
    "artworkList": 6,
    "artworkGrid": 12,
    "artworkNowPlaying": 18,
    "pill": 999,
    "miniPlayer": 12,
    "artworkFraction": 0.06
  },
  "spacing": {
    "xxs": 2,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32,
    "xxxl": 48,
    "pageGutter": 16,
    "pageGutterDesktop": 32
  },
  "size": {
    "listArtwork": 48,
    "gridArtworkMin": 168,
    "miniPlayerHeight": 68,
    "miniPlayerMargin": 8,
    "desktopPlayerBarHeight": 92,
    "desktopSidebarWidth": 248,
    "desktopQueuePanelWidth": 320,
    "coverWallTileMin": 120,
    "touchTargetMin": 48
  },
  "tabBar": {
    "height": 64,
    "iconSize": 24,
    "iconGap": 2,
    "labelHeight": 15,
    "innerInset": 6,
    "pillInset": 3,
    "blurSigma": 18,
    "noiseOpacity": 0.035,
    "maxPillStretch": 0.18
  },
  "typography": {
    "$description": "字号单位 sp / epx。中文使用系统字体（Android：系统默认；Windows：微软雅黑 UI / Segoe UI Variable）。",
    "display": { "size": 36, "weight": 700, "lineHeight": 42, "letterSpacing": -0.6 },
    "title1": { "size": 28, "weight": 700, "lineHeight": 34, "letterSpacing": -0.3 },
    "title2": { "size": 22, "weight": 600, "lineHeight": 28, "letterSpacing": -0.1 },
    "headline": { "size": 16, "weight": 600, "lineHeight": 22 },
    "body": { "size": 15, "weight": 400, "lineHeight": 21 },
    "callout": { "size": 13, "weight": 400, "lineHeight": 18 },
    "caption": { "size": 11, "weight": 400, "lineHeight": 15, "letterSpacing": 0.3 },
    "lyricsActive": { "size": 32, "weight": 700, "lineHeight": 40, "letterSpacing": -0.2 },
    "lyricsInactive": { "size": 32, "weight": 700, "lineHeight": 40, "opacity": 0.35, "blurRadius": 1.5 }
  },
  "motion": {
    "$description": "统一的弹簧参数：stiffness（刚度）+ dampingRatio（阻尼比）。Android 对应 spring()，Windows 对应 Composition SpringScalarNaturalMotionAnimation（Period ≈ 2π/√stiffness）。",
    "spring": {
      "standard": { "stiffness": 380, "dampingRatio": 0.86 },
      "emphasized": { "stiffness": 220, "dampingRatio": 0.78 },
      "gentle": { "stiffness": 120, "dampingRatio": 1.0 },
      "lyricsScroll": { "stiffness": 90, "dampingRatio": 0.92 }
    },
    "durationMs": {
      "fast": 150,
      "normal": 250,
      "slow": 400,
      "backgroundCrossfade": 900,
      "navBounce": 480,
      "navFlat": 170
    }
  },
  "nowPlaying": {
    "$description": "正在播放页动态背景：从封面调色板取色生成流动渐变。",
    "gradientColors": 4,
    "gradientCycleMs": 24000,
    "lowPowerFallback": "static-blur",
    "blurRadius": 160,
    "protectionOpacity": 0,
    "topBarProtectionOpacity": 0.4,
    "topBarProtectionHeight": 0.22,
    "gradientOpacity": 0.55,
    "noiseOpacity": 0.12,
    "dragCommitFraction": 0.35,
    "dragCommitVelocity": 700
  }
}
