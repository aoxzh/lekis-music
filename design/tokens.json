{
  "$description": "Lekis 设计 Token 的唯一来源。Android（core/designsystem/.../Tokens.kt）和 Windows（Themes/Tokens.xaml）必须与本文件一致；以后用脚本自动生成。颜色为 #RRGGBB 或 #AARRGGBB。",
  "version": 1,
  "color": {
    "light": {
      "background": "#FBFAFF",
      "surface": "#FFFFFF",
      "surfaceVariant": "#F1EFF8",
      "surfaceElevated": "#FFFFFF",
      "onBackground": "#14131A",
      "onSurface": "#14131A",
      "onSurfaceVariant": "#5E5B6B",
      "outline": "#DDDAE6",
      "accent": "#5B57D6",
      "onAccent": "#FFFFFF",
      "accentSoft": "#E7E5FF",
      "moon": "#E8B04B",
      "danger": "#D6455B",
      "scrim": "#66000000"
    },
    "dark": {
      "background": "#0B0A10",
      "surface": "#15141C",
      "surfaceVariant": "#201E29",
      "surfaceElevated": "#1C1B24",
      "onBackground": "#F3F1FA",
      "onSurface": "#F3F1FA",
      "onSurfaceVariant": "#A9A5B8",
      "outline": "#2E2C3A",
      "accent": "#9C99FF",
      "onAccent": "#0B0A10",
      "accentSoft": "#2A2850",
      "moon": "#F2C46B",
      "danger": "#FF6B81",
      "scrim": "#99000000"
    },
    "oledBlack": {
      "$description": "纯黑 OLED 主题：只覆盖这些值，其余沿用 dark。",
      "background": "#000000",
      "surface": "#0A0A0D"
    }
  },
  "radius": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "artworkList": 6,
    "artworkGrid": 10,
    "artworkNowPlaying": 14,
    "pill": 999
  },
  "spacing": {
    "xxs": 2,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32,
    "xxxl": 48,
    "pageGutter": 16,
    "pageGutterDesktop": 32
  },
  "size": {
    "listArtwork": 48,
    "gridArtworkMin": 160,
    "miniPlayerHeight": 64,
    "desktopPlayerBarHeight": 88,
    "desktopSidebarWidth": 240,
    "touchTargetMin": 48
  },
  "typography": {
    "$description": "字号单位 sp / epx。中文使用系统字体（Android：系统默认；Windows：微软雅黑 UI / Segoe UI Variable）。",
    "display": { "size": 34, "weight": 700, "lineHeight": 40 },
    "title1": { "size": 28, "weight": 700, "lineHeight": 34 },
    "title2": { "size": 22, "weight": 600, "lineHeight": 28 },
    "headline": { "size": 17, "weight": 600, "lineHeight": 22 },
    "body": { "size": 15, "weight": 400, "lineHeight": 20 },
    "callout": { "size": 14, "weight": 400, "lineHeight": 19 },
    "caption": { "size": 12, "weight": 400, "lineHeight": 16 },
    "lyricsActive": { "size": 30, "weight": 700, "lineHeight": 38 },
    "lyricsInactive": { "size": 30, "weight": 700, "lineHeight": 38, "opacity": 0.35, "blurRadius": 1.5 }
  },
  "motion": {
    "$description": "统一的弹簧参数：stiffness（刚度）+ dampingRatio（阻尼比）。Android 对应 spring()，Windows 对应 Composition SpringScalarNaturalMotionAnimation（Period ≈ 2π/√stiffness）。",
    "spring": {
      "standard": { "stiffness": 380, "dampingRatio": 0.86 },
      "emphasized": { "stiffness": 220, "dampingRatio": 0.78 },
      "gentle": { "stiffness": 120, "dampingRatio": 1.0 },
      "lyricsScroll": { "stiffness": 90, "dampingRatio": 0.92 }
    },
    "durationMs": {
      "fast": 150,
      "normal": 250,
      "slow": 400,
      "backgroundCrossfade": 900
    }
  },
  "nowPlaying": {
    "$description": "正在播放页动态背景：从封面调色板取色生成流动渐变。",
    "gradientColors": 4,
    "gradientCycleMs": 24000,
    "lowPowerFallback": "static-blur",
    "blurRadius": 80
  }
}
